# Local / shared template — copy to .env (never commit real secrets)

# Neon PostgreSQL (pooled for the app)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
# Neon direct (migrations / Prisma CLI)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

JWT_SECRET="your-secret-here"

# Public HTTPS URL (required in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# IntouchPay — server-side only, never expose to browser
INTOUCHPAY_USERNAME="ituzebb0003"
INTOUCHPAY_ACCOUNT_NUMBER="SBX00000003"
INTOUCHPAY_PARTNER_PASSWORD="your_partner_password_here"
INTOUCHPAY_BASE_URL="https://developer.intouchpay.co.rw"
INTOUCHPAY_ENV="sandbox"
# Optional override — otherwise derived from NEXT_PUBLIC_APP_URL:
# INTOUCHPAY_CALLBACK_URL="https://www.ituzebnb.com/api/payment/intouchpay/callback"

# Cloudinary (required in production for uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email notifications (optional — logs only if unset)
RESEND_API_KEY=""
EMAIL_FROM="bookings@ituzebnb.com"
EMAIL_FROM_NAME="ITUZE B&B"
SUPPORT_EMAIL="support@ituzebnb.com"

# Error monitoring (optional)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
