# Production environment — set these in Vercel (or your host). Never commit real secrets.

NODE_ENV=production

NEXT_PUBLIC_APP_URL=https://www.ituzebnb.com

# Neon (pooled for runtime)
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require
# Neon direct (migrations)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:PASSWORD@ep-xxxx.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=replace-with-long-random-secret

# IntouchPay — use production credentials when live; sandbox OK for first deploy tests
INTOUCHPAY_USERNAME=
INTOUCHPAY_ACCOUNT_NUMBER=
INTOUCHPAY_PARTNER_PASSWORD=
INTOUCHPAY_BASE_URL=https://www.intouchpay.co.rw
INTOUCHPAY_ENV=production
INTOUCHPAY_CALLBACK_URL=https://www.ituzebnb.com/api/payment/intouchpay/callback

# Cloudinary (required for room/hero/logo uploads on Vercel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend recommended)
RESEND_API_KEY=
EMAIL_FROM=bookings@ituzebnb.com
EMAIL_FROM_NAME=ITUZE B&B
SUPPORT_EMAIL=support@ituzebnb.com

# Error monitoring (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
